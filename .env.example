# 应用配置 (development开发环境/production生产环境)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# 国内/国际版(zh/en)切换
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh

# 部署区域配置 (CN/INTL)
# 设置为 CN 使用CloudBase，INTL 使用Supabase
NEXT_PUBLIC_DEPLOYMENT_REGION=INTL  # 或 CN
DEPLOYMENT_REGION=INTL  # 服务器端部署区域
NEXT_PUBLIC_SITE_REGION=intl  # 客户端部署区域，兼容旧变量

# 游客模式配置
NEXT_PUBLIC_GUEST_DAILY_LIMIT=1
NEXT_PUBLIC_GUEST_SUPPORT_BATCH_BUILD=false

# Supabase 配置 (国际版) - 推荐用于开发和生产
# 获取方式: Supabase项目设置 -> API -> Project URL & anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CloudBase 配置 (国内版 - 腾讯云) - 适用于国内部署
# 获取方式: 腾讯云CloudBase控制台 -> 环境ID & 访问密钥
CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_SECRET_ID=your-secret-id
CLOUDBASE_SECRET_KEY=your-secret-key
CLOUDBASE_BUCKET_ID=your-bucket-id  # 可选，用于文件存储

# 邮件发送配置 (用于发送合作邮件)
# 实际发送邮件需要配置真实的SMTP服务器
AUTH_EMAIL_SMTP_HOST=smtp.example.com
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_USER=user@example.com
AUTH_EMAIL_SMTP_PASS=password
AUTH_EMAIL_FROM=noreply@example.com

# 管理员认证密钥 (生产环境必须修改！)
MARKET_ADMIN_JWT_SECRET=market-admin-jwt-secret-change-me
ADMIN_SESSION_SECRET=admin-session-secret-change-me
JWT_SECRET=your-jwt-secret-change-me

# NextAuth 配置 (用于身份验证)
NEXTAUTH_SECRET=your-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# Stripe 支付配置 (国际版)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Google OAuth 配置
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-for-web
GOOGLE_CLIENT_SECRET=your-google-client-secret-for-web

# PayPal 支付配置 (国际版)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SKIP_SIGNATURE_VERIFICATION=true
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# 微信支付配置 (国内版)
WECHAT_PAY_APP_ID=your-wechat-pay-app-id
WECHAT_PAY_MCH_ID=your-wechat-pay-mch-id
WECHAT_PAY_API_V3_KEY=your-wechat-pay-api-v3-key
WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WECHAT_PAY_SERIAL_NO=your-wechat-pay-serial-no

# AI 服务配置
AI_PROVIDER=openrouter
AI_PROVIDER_CN=aliyun
AI_PROVIDER_INTL=openrouter
ALIYUN_DASHSCOPE_API_KEY=your-aliyun-dashscope-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=perplexity/sonar
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_MODEL_CN=qwen-coder-turbo
DEFAULT_MODEL_INTL=gpt-4o-mini

# 其他配置
GEO_FAIL_CLOSED=false
MAX_IMAGE_UPLOAD_MB=5
USER_DAILY_CALLS=100
USER_MONTHLY_CNY=10
PROJECT_BUDGET_CNY_MONTH=100